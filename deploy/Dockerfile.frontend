# ---- build stage ----
FROM node:22-alpine AS build

WORKDIR /app/agent-web

# Install deps first (cached unless lock files change)
COPY agent-web/package.json agent-web/package-lock.json ./
RUN npm ci

# Copy source and build
COPY agent-web/ ./
RUN npm run build

# ---- serve stage ----
FROM nginx:alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/agent-web/dist /usr/share/nginx/html

EXPOSE 80
