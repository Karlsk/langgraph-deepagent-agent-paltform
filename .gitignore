# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
*.jsonl

# Virtual environments
.venv

# Environment variables
.env
.env.development
.env.staging
.env.production

# Misc
*.ipynb
.superpowers/

# Reports
evals/reports/
.qoder
.coverage*

# SDN real-credential workflow config (template committed instead)
app/sdn/config/sdn_alert_inspection.yaml

# Runtime-saved workflow definitions (S17): the user/ directory is written by
# PUT /workflows/{id} at run time, so its YAMLs are host data, not source. Only
# .gitkeep is tracked. Curated, reviewable workflows belong in config/examples/.
app/workflow/config/user/*.yaml

# Frontend
node_modules/
*.tsbuildinfo

# MCP stdio manifest directory: only the README is tracked; runtime
# manifests (*.json) and any helper scripts (*.py) are host-managed and
# must NOT be committed (see mcp-servers/README.md).
mcp-servers/*.json
mcp-servers/*.py

# Skills runtime store (SKILLS_ROOT=./data/skills, bind-mounted into the
# app container): machine-local SKILL.md copies; the DB body column is the
# source of truth, so this directory must NOT be committed.
data/
