# Environment Configuration Example

# Application Settings
APP_ENV=development
PROJECT_NAME="Web Assistant"
VERSION=1.0.0
DEBUG=true

# API Settings
API_V1_STR=/api/v1

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# Langfuse Settings
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM Settings
OPENAI_API_KEY="your-llm-api-key" # e.g. OpenAI API key
ANTHROPIC_API_KEY=
DEFAULT_LLM_MODEL=gpt-5-mini
# LLMService model fallback chain (comma-separated, real model ids of the endpoint; defaults to DEFAULT_LLM_MODEL)
# LLM_MODELS=gpt-5-mini,gpt-5

# Atlas Cloud (OpenAI-compatible) — alternative to OpenAI, access 59+ LLMs with one key
# Get your free key at: https://www.atlascloud.ai/console/coding-plan
# OPENAI_BASE_URL=https://api.atlascloud.ai/v1
# OPENAI_API_KEY=<your-atlascloud-key>
# DEFAULT_LLM_MODEL=deepseek-ai/deepseek-v4-pro
DEFAULT_LLM_TEMPERATURE=0.2
SESSION_NAMING_ENABLED=true

# JWT Settings
JWT_SECRET_KEY="your-jwt-secret-key"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# Database Settings
POSTGRES_HOST=db
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PORT=5432
POSTGRES_PASSWORD=mypassword
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Rate Limiting Settings
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="100 per minute"
# Agent asset management endpoints
RATE_LIMIT_SUBAGENT="60 per minute"
RATE_LIMIT_SKILL="60 per minute"
RATE_LIMIT_AGENT_APP="60 per minute"
RATE_LIMIT_MCP_SERVER="60 per minute"
RATE_LIMIT_MCP_TOOLS_DEBUG="30 per minute"
RATE_LIMIT_PROVIDER="60 per minute"
RATE_LIMIT_MODEL_CONFIG="60 per minute"
RATE_LIMIT_TOOLS_CATALOG="60 per minute"
RATE_LIMIT_SUBAGENT_TEST="5 per minute"
RATE_LIMIT_SKILL_GENERATE="5 per minute"

# Skills Storage
# Root directory of SKILL.md assets (global + per-user copies).
# For production prefer an absolute path on a writable, persistent volume.
SKILLS_ROOT=./data/skills

# MCP Settings
# stdio command allowlist (comma-separated executable basenames)
MCP_STDIO_ALLOWED_COMMANDS=python,node,uvx,npx
# Pooled MCP session idle TTL in seconds (recycled on next use after this;
# kept below the adapters' 300s sse_read_timeout)
MCP_SESSION_IDLE_TTL=240
# Grace period in seconds for a pooled session worker's graceful exit on
# close/shutdown before force-cancel (still inside the worker task; anyio
# cancel-scope task affinity preserved)
MCP_SESSION_STOP_TIMEOUT=10
# Root directory of stdio MCP manifests (one JSON file per server;
# Docker deployments mount ./mcp-servers here)
MCP_STDIO_ROOT=./mcp-servers

# Profiling Settings
PROFILING_DIR=/tmp/fastapi_profiles
PROFILING_THRESHOLD_SECONDS=2.0

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console
